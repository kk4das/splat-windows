<Window x:Class="SplatWin.App.EarthWebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Google Earth on the web" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20,16,20,18">
        <TextBlock Text="Open it in Google Earth on the web" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.78" FontSize="12"
                   Text="The web version of Google Earth opens the same file as Google Earth Pro. It needs a Google account, and it doesn't upload anything until you choose the file yourself."/>
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" x:Name="StepsText"/>
        <TextBox x:Name="FileBox" Margin="0,10,0,0" IsReadOnly="True" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap"
                 AutomationProperties.Name="The file to import"/>
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="WebButton" Content="Open earth.google.com" Padding="12,6" Click="Web_Click" Style="{DynamicResource AccentButtonStyle}"/>
            <Button x:Name="ShowButton" Content="Show the file" Padding="12,6" Margin="8,0,0,0" Click="Show_Click"/>
            <Button x:Name="CopyButton" Content="Copy its path" Padding="12,6" Margin="8,0,0,0" Click="Copy_Click"/>
        </StackPanel>
        <TextBlock x:Name="DoneText" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"/>
        <Button Content="Close" Padding="14,6" Margin="0,14,0,0" HorizontalAlignment="Right" IsCancel="True"/>
    </StackPanel>
</Window>
