<Window x:Class="SplatWin.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:SplatWin.App"
        Title="SPLAT! for Windows (preview)" Width="1280" Height="840" MinWidth="760" MinHeight="480" Icon="splat.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.78"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,6"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="12,8">
            <DockPanel LastChildFill="False">
                <Button x:Name="OpenButton" Content="Open coverage map…" Padding="14,6" Click="Open_Click"
                        ToolTip="Open a SPLAT! coverage map (.kml made with -kml)"/>
                <Button x:Name="EarthButton" Content="Open in Google Earth Pro" Padding="14,6" Margin="8,0,0,0"
                        IsEnabled="False" Click="Earth_Click" ToolTip="Open the map or path shown in Google Earth Pro"/>
                <Button x:Name="EarthWebButton" Content="Google Earth on the web…" Padding="10,6" Margin="6,0,0,0"
                        IsEnabled="False" Click="EarthWeb_Click" ToolTip="How to open the same file in Google Earth in a web browser"/>
                <TextBlock Text="Map opacity" VerticalAlignment="Center" Margin="24,0,8,0"/>
                <Slider x:Name="OpacitySlider" Width="160" Minimum="0" Maximum="1" Value="0.65" VerticalAlignment="Center"
                        ValueChanged="Opacity_Changed" IsEnabled="False"/>
                <Button x:Name="HelpButton" DockPanel.Dock="Right" Content="Help" Padding="14,6" Margin="8,0,0,0" Click="HelpMenu_Click"
                        ToolTip="Help contents, index and search, getting started, setup, about (F1: help for what you're looking at)">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="HelpMenu">
                            <MenuItem x:Name="HelpContentsItem" Header="Contents" InputGestureText="F1" Click="HelpContents_Click"/>
                            <MenuItem x:Name="HelpIndexItem" Header="Index" Click="HelpIndex_Click"/>
                            <MenuItem x:Name="HelpSearchItem" Header="Search" Click="HelpSearch_Click"/>
                            <Separator/>
                            <MenuItem x:Name="HelpStartItem" Header="Getting started" Click="HelpStart_Click"/>
                            <MenuItem x:Name="HelpSetupItem" Header="Setup…" Click="HelpSetup_Click"/>
                            <MenuItem x:Name="HelpTroubleItem" Header="Troubleshooting" Click="HelpTrouble_Click"/>
                            <Separator/>
                            <MenuItem x:Name="HelpAboutItem" Header="About SPLAT! for Windows" Click="HelpAbout_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="Settings…" Padding="14,6" Margin="8,0,0,0" Click="Settings_Click"
                        ToolTip="Terrain folder, defaults for new maps, map opacity, QRZ.com and Google Earth"/>
                <Button x:Name="QrzButton" DockPanel.Dock="Right" Content="QRZ.com: sign in…" Padding="14,6" Click="Qrz_Click"
                        ToolTip="Sign in to QRZ.com for worldwide call sign lookups (needs your QRZ XML Logbook Data subscription)"/>
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Bottom" Padding="12,4">
            <TextBlock x:Name="Status" Text="Starting…" TextTrimming="CharacterEllipsis"/>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350" MinWidth="280"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="14,4,8,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Always here, whatever the panel below shows; the current one is highlighted. -->
                <UniformGrid x:Name="NavBar" Rows="2" Columns="2" Margin="0,4,0,12">
                    <Button x:Name="AddButton" Content="Add station…" Padding="10,5" Margin="0,0,4,4" HorizontalAlignment="Stretch" Click="Add_Click"
                            ToolTip="Add a station by call sign, address, grid square, coordinates or a click on the map"/>
                    <Button x:Name="ImportButton" Content="Import .qth…" Padding="10,5" Margin="4,0,0,4" HorizontalAlignment="Stretch" Click="Import_Click"
                            ToolTip="Add stations from SPLAT! .qth files (a .lrp, .az or .el file beside one comes too)"/>
                    <Button x:Name="PathButton" Content="Analyze a path…" Padding="10,5" Margin="0,4,4,0" HorizontalAlignment="Stretch" Click="PathOpen_Click"
                            ToolTip="Pick a transmitter and a receiver and run SPLAT!'s path analysis"/>
                    <Button x:Name="CoverageButton" Content="Coverage map…" Padding="10,5" Margin="4,4,0,0" HorizontalAlignment="Stretch" Click="CoverageOpen_Click"
                            ToolTip="Map a transmitter's coverage with SPLAT!, shown on the map in this window"/>
                </UniformGrid>
                <!-- Fixed too (never scrolls away): back to the list from path analysis, coverage maps or the editor. -->
                <Button x:Name="BackButton" Grid.Row="1" Content="Back to stations" Padding="10,4" Margin="0,0,0,10" HorizontalAlignment="Left"
                        Visibility="Collapsed" Click="Back_Click"/>
                <Grid Grid.Row="2">
                <!-- The stations list -->
                <DockPanel x:Name="ListPanel">
                    <TextBlock DockPanel.Dock="Top" Text="Stations" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="EditButton" Content="Edit…" Padding="12,5" Click="Edit_Click" IsEnabled="False"/>
                        <Button x:Name="DeleteButton" Content="Delete" Padding="12,5" Margin="8,0,0,0" Click="Delete_Click" IsEnabled="False"/>
                        <Button x:Name="ExportButton" Content="Export .qth…" Padding="12,5" Margin="8,0,0,0" Click="Export_Click" IsEnabled="False"
                                ToolTip="Save the station as a SPLAT! .qth file, for the command line"/>
                    </StackPanel>
                    <TextBlock x:Name="EmptyHint" DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,4,0,8"
                               Text="No stations yet. Add one by call sign, grid square, coordinates or a click on the map, or import your .qth files."/>
                    <ListBox x:Name="StationList" SelectionChanged="StationList_SelectionChanged" MouseDoubleClick="Edit_Click"
                             AutomationProperties.Name="Stations">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Caption}">
                                        <Run Text="{Binding Grid, Mode=OneWay}"/><Run Text="  ·  antenna "/><Run Text="{Binding HeightText, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Source}" Style="{StaticResource Caption}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Adding or editing one station -->
                <ScrollViewer x:Name="EditorPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock x:Name="EditorTitle" Text="New station" FontSize="20" FontWeight="SemiBold"/>

                        <TextBlock Style="{StaticResource Heading}" Text="1. Find the place"/>
                        <TabControl x:Name="MethodTabs" SelectionChanged="Method_Changed" Padding="0" BorderThickness="0">
                            <TabItem Header="Call sign" AutomationProperties.Name="Call sign"/>
                            <TabItem Header="Address" AutomationProperties.Name="Address"/>
                            <TabItem Header="Grid" AutomationProperties.Name="Grid"/>
                            <TabItem Header="Coordinates" AutomationProperties.Name="Coordinates"/>
                            <TabItem Header="Map" AutomationProperties.Name="Map"/>
                        </TabControl>
                        <DockPanel x:Name="FindRow" Margin="0,8,0,0">
                            <Button x:Name="FindButton" DockPanel.Dock="Right" Content="Find" Padding="14,5" Margin="8,0,0,0" Click="Find_Click"/>
                            <TextBox x:Name="FindBox" KeyDown="FindBox_KeyDown" AutomationProperties.Name="Find"/>
                        </DockPanel>
                        <TextBlock x:Name="MethodHint" Style="{StaticResource Caption}" Margin="0,5,0,0"/>
                        <ListBox x:Name="MatchList" Visibility="Collapsed" Margin="0,8,0,0" MaxHeight="190"
                                 SelectionChanged="MatchList_SelectionChanged" AutomationProperties.Name="Matches"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap"/>
                                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                                            <Run Text="{Binding Source, Mode=OneWay}"/><Run Text=": "/><Run Text="{Binding PrecisionText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border x:Name="NoteBox" Visibility="Collapsed" Padding="10,8" Margin="0,10,0,0" CornerRadius="4"
                                BorderThickness="1" BorderBrush="#C8A000" Background="#26FFB900">
                            <TextBlock x:Name="NoteText" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Style="{StaticResource Heading}" Text="2. Put the pin on the antenna"/>
                        <TextBlock Style="{StaticResource Caption}"
                                   Text="Drag the pin, or click the map, until it sits on the antenna itself. Zoom in to be precise."/>
                        <TextBlock x:Name="PinText" Margin="0,8,0,8" FontFamily="Consolas" Text="No pin yet."/>
                        <CheckBox x:Name="ConfirmBox" Content="The pin is on the antenna site" IsEnabled="False"/>

                        <TextBlock Style="{StaticResource Heading}" Text="3. Name and antenna height"/>
                        <TextBlock Text="Name (usually the call sign)" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                        <TextBox x:Name="NameBox" MaxLength="48" AutomationProperties.Name="Name"/>
                        <TextBlock Text="Antenna height above ground" Style="{StaticResource Caption}" Margin="0,10,0,3"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="HeightBox" Width="110" AutomationProperties.Name="Antenna height"/>
                            <ComboBox x:Name="UnitBox" Width="80" Margin="8,0,0,0" SelectedIndex="0" AutomationProperties.Name="Height unit">
                                <ComboBoxItem Content="ft"/>
                                <ComboBoxItem Content="m"/>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Style="{StaticResource Heading}" Text="4. Antenna pattern (optional)"/>
                        <TextBlock x:Name="PatternText" Style="{StaticResource Caption}" Margin="0,0,0,6" Text="None: the same in all directions."/>
                        <Button x:Name="PatternHelpButton" Content="What does this mean?" Padding="8,2" Margin="0,0,0,8" HorizontalAlignment="Left"
                                Click="HelpLink_Click" Tag="stations.html#antenna-pattern" ToolTip="Antenna pattern files (.az and .el)"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PatternButton" Content="Choose .az file…" Padding="10,4" Click="Pattern_Click"
                                    ToolTip="SPLAT!'s antenna pattern files: name.az (azimuth) and, beside it, name.el (elevation). Used when this station transmits."/>
                            <Button x:Name="PatternClearButton" Content="Remove" Padding="10,4" Margin="8,0,0,0" Click="PatternClear_Click" IsEnabled="False"/>
                        </StackPanel>

                        <TextBlock x:Name="EditorError" Foreground="#D13438" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                            <Button x:Name="SaveButton" Content="Save station" Padding="14,6" Click="Save_Click"
                                    Style="{DynamicResource AccentButtonStyle}"/>
                            <Button x:Name="CancelButton" Content="Cancel" Padding="14,6" Margin="8,0,0,0" Click="Cancel_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Coverage maps (G4) -->
                <ScrollViewer x:Name="CoveragePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="Coverage map" FontSize="20" FontWeight="SemiBold"/>

                        <TextBlock Style="{StaticResource Heading}" Text="Transmitter"/>
                        <ComboBox x:Name="CovTxBox" SelectionChanged="CovTxBox_SelectionChanged" AutomationProperties.Name="Coverage transmitter"/>
                        <TextBlock x:Name="CovRadioHint" Style="{StaticResource Caption}" Margin="0,6,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Frequency (MHz)" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                <TextBox x:Name="CovFreqBox" AutomationProperties.Name="Coverage frequency"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ERP (watts)" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                <TextBox x:Name="CovErpBox" AutomationProperties.Name="Coverage ERP"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Style="{StaticResource Heading}" Text="Map"/>
                        <TextBlock Text="What to show" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CovKindBox" SelectedIndex="0" SelectionChanged="CovKindBox_SelectionChanged" AutomationProperties.Name="What to show">
                            <ComboBoxItem Content="Signal strength (dBµV/m)"/>
                            <ComboBoxItem Content="Received power (dBm)"/>
                            <ComboBoxItem Content="Path loss (dB)"/>
                            <ComboBoxItem Content="Line of sight"/>
                        </ComboBox>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="CovRadiusLabel" Text="Radius (miles)" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                <TextBox x:Name="CovRadiusBox" Text="30" AutomationProperties.Name="Radius"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="CovRxLabel" Text="Receiver antenna (ft)" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                <TextBox x:Name="CovRxBox" Text="6" AutomationProperties.Name="Receiver antenna height"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="CovKindHint" Style="{StaticResource Caption}" Margin="0,6,0,0"/>
                        <Expander x:Name="CovMoreBox" Header="More options" Margin="0,10,0,0" AutomationProperties.Name="More options">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="Propagation model" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                <ComboBox x:Name="CovModelBox" SelectedIndex="0" AutomationProperties.Name="Coverage model">
                                    <ComboBoxItem Content="ITWOM 3.0 (SPLAT!'s default)"/>
                                    <ComboBoxItem Content="Longley-Rice ITM (-olditm)"/>
                                </ComboBox>
                                <CheckBox x:Name="CovShadingBox" Content="Gray terrain shading (off: only the coverage colors, over the street map)" Margin="0,10,0,0" IsChecked="True"/>
                                <CheckBox x:Name="CovSmoothBox" Content="Smooth color bands (-sc)" Margin="0,8,0,0"/>
                                <CheckBox x:Name="CovMetricBox" Content="Kilometers and meters (-metric)" Margin="0,8,0,0" Click="CovMetric_Click"/>
                                <CheckBox x:Name="CovHdBox" Content="High-definition terrain (1 arc-second, splat-hd; slower)" Margin="0,8,0,0"/>
                                <TextBlock Text="Obstacles (SPLAT! user terrain, .udt)" Style="{StaticResource Caption}" Margin="0,10,0,3"/>
                                <DockPanel>
                                    <Button x:Name="CovUdtClearButton" DockPanel.Dock="Right" Content="Clear" Padding="8,3" Margin="6,0,0,0" Click="UdtClear_Click" IsEnabled="False"/>
                                    <Button x:Name="CovUdtButton" DockPanel.Dock="Right" Content="Choose…" Padding="8,3" Margin="6,0,0,0" Click="Udt_Click"/>
                                    <TextBlock x:Name="CovUdtText" Text="None" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                                           Text="Ground, climate and the other radio settings are the transmitter's, from Analyze a path."/>
                            </StackPanel>
                        </Expander>

                        <TextBlock Style="{StaticResource Heading}" Text="Terrain"/>
                        <DockPanel>
                            <Button x:Name="CovTerrainButton" DockPanel.Dock="Right" Content="Change…" Padding="10,4" Margin="8,0,0,0" Click="Terrain_Click"/>
                            <TextBlock x:Name="CovTerrainText" Style="{StaticResource Caption}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </DockPanel>

                        <TextBlock x:Name="CovError" Foreground="#D13438" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                            <Button x:Name="CovRunButton" Content="Run" Padding="18,6" Click="CovRun_Click" Style="{DynamicResource AccentButtonStyle}"/>
                            <Button x:Name="CovCancelButton" Content="Cancel" Padding="14,6" Margin="8,0,0,0" Click="CovCancel_Click" Visibility="Collapsed"
                                    ToolTip="Stop making this map"/>
                        </StackPanel>

                        <Border x:Name="CovResultBox" Visibility="Collapsed" Padding="10,8" Margin="0,6,0,8" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                            <StackPanel>
                                <TextBlock x:Name="CovResultText" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                <TextBlock x:Name="CovResultNote" TextWrapping="Wrap" Margin="0,4,0,0" Style="{StaticResource Caption}"/>
                                <Image x:Name="CovKeyImage" Margin="0,8,0,0" HorizontalAlignment="Left" Stretch="None"
                                       AutomationProperties.Name="Color key" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                <TextBlock x:Name="CovKeyText" TextWrapping="Wrap" Margin="0,6,0,0" Style="{StaticResource Caption}"/>
                                <Button x:Name="CovKeyHelpButton" Content="What does this mean?" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Click="HelpLink_Click" Tag="coverage-maps.html#color-key" ToolTip="How to read the color key and the map"/>
                                <Button x:Name="CovFolderButton" Content="Open the job folder" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Click="CovFolder_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource Heading}" Text="Earlier maps"/>
                        <TextBlock x:Name="CovHistoryHint" Style="{StaticResource Caption}" Margin="0,0,0,4"/>
                        <ListBox x:Name="CovHistory" MaxHeight="220" VirtualizingPanel.IsVirtualizing="False" SelectionChanged="CovHistory_SelectionChanged" AutomationProperties.Name="Earlier maps"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" Margin="0,2"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Path analysis (G3) -->
                <ScrollViewer x:Name="PathPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,6,0">
                        <TextBlock Text="Path analysis" FontSize="20" FontWeight="SemiBold"/>

                        <TextBlock Style="{StaticResource Heading}" Text="Stations"/>
                        <TextBlock Text="Transmitter" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                        <ComboBox x:Name="TxBox" SelectionChanged="TxBox_SelectionChanged" AutomationProperties.Name="Transmitter"/>
                        <TextBlock Text="Receiver" Style="{StaticResource Caption}" Margin="0,8,0,3"/>
                        <DockPanel>
                            <Button x:Name="SwapButton" DockPanel.Dock="Right" Content="Swap" Padding="10,4" Margin="8,0,0,0" Click="Swap_Click"
                                    ToolTip="Swap the transmitter and the receiver"/>
                            <ComboBox x:Name="RxBox" AutomationProperties.Name="Receiver"/>
                        </DockPanel>

                        <TextBlock Style="{StaticResource Heading}" Text="Transmitter radio"/>
                        <TextBlock x:Name="RadioHint" Style="{StaticResource Caption}" Margin="0,0,0,6"/>
                        <Button x:Name="RadioHelpButton" Content="What does this mean?" Padding="8,2" Margin="0,0,0,8" HorizontalAlignment="Left"
                                Click="HelpLink_Click" Tag="radio-settings.html" ToolTip="Each radio setting in plain words"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Frequency (MHz)" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                <TextBox x:Name="FreqBox" AutomationProperties.Name="Frequency"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ERP (watts)" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                <TextBox x:Name="ErpBox" AutomationProperties.Name="ERP"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Polarization" Style="{StaticResource Caption}" Margin="0,8,0,3"/>
                        <ComboBox x:Name="PolBox" SelectedIndex="1" AutomationProperties.Name="Polarization">
                            <ComboBoxItem Content="Horizontal"/>
                            <ComboBoxItem Content="Vertical"/>
                        </ComboBox>
                        <Button x:Name="LrpButton" Content="Load from a .lrp file…" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Left"
                                Click="Lrp_Click" ToolTip="Fill in these settings from an existing SPLAT! .lrp file"/>

                        <Expander x:Name="MoreBox" Header="Ground, climate and model" Margin="0,12,0,0" AutomationProperties.Name="Ground, climate and model">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="Ground" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                <ComboBox x:Name="GroundBox" AutomationProperties.Name="Ground"/>
                                <TextBlock Text="Radio climate" Style="{StaticResource Caption}" Margin="0,8,0,3"/>
                                <ComboBox x:Name="ClimateBox" AutomationProperties.Name="Radio climate"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Situations (%)" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="SitBox" AutomationProperties.Name="Situations"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Time (%)" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="TimeBox" AutomationProperties.Name="Time"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Atmospheric bending (N-units)" Style="{StaticResource Caption}" Margin="0,8,0,3"/>
                                <TextBox x:Name="BendBox" AutomationProperties.Name="Atmospheric bending"/>
                                <TextBlock Text="Propagation model" Style="{StaticResource Caption}" Margin="0,8,0,3"/>
                                <ComboBox x:Name="ModelBox" SelectedIndex="0" AutomationProperties.Name="Propagation model">
                                    <ComboBoxItem Content="ITWOM 3.0 (SPLAT!'s default)"/>
                                    <ComboBoxItem Content="Longley-Rice ITM (-olditm)"/>
                                </ComboBox>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Fresnel clearance (%)" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="FzBox" Text="60" AutomationProperties.Name="Fresnel clearance"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock x:Name="ClutterLabel" Text="Ground clutter (ft)" Style="{StaticResource Caption}" Margin="0,0,0,3"/>
                                        <TextBox x:Name="ClutterBox" Text="0" AutomationProperties.Name="Ground clutter"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Units in the report" Style="{StaticResource Caption}" Margin="0,8,0,3"/>
                                <ComboBox x:Name="UnitsBox" SelectedIndex="0" SelectionChanged="UnitsBox_SelectionChanged" AutomationProperties.Name="Units">
                                    <ComboBoxItem Content="Miles and feet"/>
                                    <ComboBoxItem Content="Kilometers and meters (-metric)"/>
                                </ComboBox>
                                <CheckBox x:Name="HdBox" Content="High-definition terrain (1 arc-second, splat-hd)" Margin="0,10,0,0"/>
                                <TextBlock Text="Obstacles (SPLAT! user terrain, .udt)" Style="{StaticResource Caption}" Margin="0,10,0,3"/>
                                <DockPanel>
                                    <Button x:Name="UdtClearButton" DockPanel.Dock="Right" Content="Clear" Padding="8,3" Margin="6,0,0,0" Click="UdtClear_Click" IsEnabled="False"/>
                                    <Button x:Name="UdtButton" DockPanel.Dock="Right" Content="Choose…" Padding="8,3" Margin="6,0,0,0" Click="Udt_Click"/>
                                    <TextBlock x:Name="UdtText" Text="None" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </StackPanel>
                        </Expander>

                        <TextBlock Style="{StaticResource Heading}" Text="Terrain"/>
                        <DockPanel>
                            <Button x:Name="TerrainButton" DockPanel.Dock="Right" Content="Change…" Padding="10,4" Margin="8,0,0,0" Click="Terrain_Click"/>
                            <TextBlock x:Name="TerrainText" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <TextBlock x:Name="PathError" Foreground="#D13438" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                            <Button x:Name="AnalyseButton" Content="Analyze" Padding="18,6" Click="Analyse_Click"
                                    Style="{DynamicResource AccentButtonStyle}"/>
                            <Button x:Name="PathCancelButton" Content="Cancel" Padding="14,6" Margin="8,0,0,0" Click="PathCancel_Click" Visibility="Collapsed"
                                    ToolTip="Stop this analysis"/>
                        </StackPanel>

                        <!-- The result's headline numbers: SPLAT!'s own text from the report -->
                        <Border x:Name="SummaryBox" Visibility="Collapsed" Padding="10,8" Margin="0,6,0,8" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                            <StackPanel>
                                <TextBlock x:Name="SumTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="SumLos" TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SumNumbers" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" FontSize="12"/>
                                <TextBlock x:Name="SumWarning" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#D13438" Visibility="Collapsed"/>
                                <TextBlock x:Name="SumClearance" TextWrapping="Wrap" Margin="0,6,0,0" Style="{StaticResource Caption}"/>
                                <Button x:Name="SumHelpButton" Content="What does this mean?" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Click="HelpLink_Click" Tag="path-analysis.html#summary" ToolTip="What each number in the summary means, and the white circles on the map"/>
                                <TextBlock x:Name="SumEarth" TextWrapping="Wrap" Margin="0,6,0,0" Style="{StaticResource Caption}"/>
                                <Button x:Name="JobFolderButton" Content="Open the job folder" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Left"
                                        Click="JobFolder_Click" ToolTip="The inputs, SPLAT!'s outputs and run-again.cmd, which repeats the job from the command line"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120"/>
                    <RowDefinition x:Name="ResultSplitRow" Height="0"/>
                    <RowDefinition x:Name="ResultRow" Height="0"/>
                </Grid.RowDefinitions>
                <wv2:WebView2 Grid.Row="0" x:Name="Web"/>
                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows"/>
                <TabControl Grid.Row="2" x:Name="ResultTabs" Margin="6,2,6,6" Visibility="Collapsed" AutomationProperties.Name="Path results">
                    <TabItem Header="Terrain profile" AutomationProperties.Name="Terrain profile">
                        <Grid><local:GraphView x:Name="GraphProfile" Margin="4"/><TextBlock x:Name="ErrProfile" TextWrapping="Wrap" Margin="12" Foreground="#D13438"/></Grid>
                    </TabItem>
                    <TabItem Header="Elevation angle" AutomationProperties.Name="Elevation angle">
                        <Grid><local:GraphView x:Name="GraphElevation" Margin="4"/><TextBlock x:Name="ErrElevation" TextWrapping="Wrap" Margin="12" Foreground="#D13438"/></Grid>
                    </TabItem>
                    <TabItem Header="Height and Fresnel zone" AutomationProperties.Name="Height and Fresnel zone">
                        <Grid><local:GraphView x:Name="GraphHeight" Margin="4"/><TextBlock x:Name="ErrHeight" TextWrapping="Wrap" Margin="12" Foreground="#D13438"/></Grid>
                    </TabItem>
                    <TabItem Header="Path loss" AutomationProperties.Name="Path loss">
                        <Grid><local:GraphView x:Name="GraphLoss" Margin="4"/><TextBlock x:Name="ErrLoss" TextWrapping="Wrap" Margin="12" Foreground="#D13438"/></Grid>
                    </TabItem>
                    <TabItem Header="Report" AutomationProperties.Name="Report">
                        <TextBox x:Name="ReportBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="SPLAT! report"/>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
