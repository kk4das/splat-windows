<Window x:Class="SplatWin.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="SPLAT! for Windows help" Width="1120" Height="780" MinWidth="640" MinHeight="400" Icon="splat.ico"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="220"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TabControl x:Name="HelpTabs" Margin="8,8,4,8" AutomationProperties.Name="Help navigation">
            <TabItem x:Name="ContentsTab" Header="Contents" AutomationProperties.Name="Contents">
                <ListBox x:Name="ContentsList" SelectionChanged="ContentsList_SelectionChanged" AutomationProperties.Name="Help pages"
                         VirtualizingPanel.IsVirtualizing="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap" Margin="0,3"/></DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
            <TabItem x:Name="IndexTab" Header="Index" AutomationProperties.Name="Index">
                <DockPanel>
                    <TextBox x:Name="IndexFilter" DockPanel.Dock="Top" Margin="0,6,0,6" TextChanged="IndexFilter_TextChanged"
                             AutomationProperties.Name="Type to find in the index"/>
                    <ListBox x:Name="IndexList" SelectionChanged="IndexList_SelectionChanged" AutomationProperties.Name="Index entries"
                             VirtualizingPanel.IsVirtualizing="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Term}" TextWrapping="Wrap"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <TabItem x:Name="SearchTab" Header="Search" AutomationProperties.Name="Search">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,6,0,6">
                        <Button x:Name="SearchButton" DockPanel.Dock="Right" Content="Search" Padding="12,4" Margin="6,0,0,0" Click="Search_Click"/>
                        <TextBox x:Name="SearchBox" KeyDown="SearchBox_KeyDown" AutomationProperties.Name="Search help for"/>
                    </DockPanel>
                    <TextBlock x:Name="SearchHint" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12" Opacity="0.78" Margin="0,0,0,6"
                               Text="Pages holding every word you type. For a message the app showed you, type a few of its words."/>
                    <ListBox x:Name="SearchResults" SelectionChanged="SearchResults_SelectionChanged" AutomationProperties.Name="Search results"
                             VirtualizingPanel.IsVirtualizing="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Snippet}" FontSize="12" Opacity="0.78" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
        </TabControl>
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
        <Grid Grid.Column="2">
            <wv2:WebView2 x:Name="Page" AutomationProperties.Name="Help page"/>
            <TextBlock x:Name="PageError" Margin="20" TextWrapping="Wrap" Foreground="#D13438" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
