<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SplatWin.Core\SplatWin.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>SplatForWindows</AssemblyName>
    <Product>SPLAT! for Windows</Product>
    <Version>0.4.0</Version>
    <!-- ThemeMode (the Fluent theme) is marked experimental in WPF; it is what gives the modern look. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- The map page and Leaflet (BSD-2, vendored and integrity-checked), served from the app folder. -->
    <None Include="web\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- The unchanged SPLAT! engine (built by build.ps1 into dist\) and its licence (GPLv2). The app runs these. -->
    <None Include="..\..\dist\splat.exe;..\..\dist\splat-hd.exe" Link="engine\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\COPYING" Link="engine\COPYING" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
